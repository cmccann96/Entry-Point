# Copy to .env and fill in. Never commit .env.
#
# NOTE ON WHAT THESE DO AND DO NOT BUY YOU -- read README.md "Data sources" first.
#
# PriceCharting: paid subscription required. The official API returns CURRENT
# prices only (no historic sales). It is used here as a reference-price source,
# NOT as the backtest input. It cannot supply Stage 1 data.
PRICECHARTING_TOKEN=

# eBay Browse API (OAuth app token, free tier). ACTIVE listings only.
# Cannot return sold prices. Used for Stage 2 asks, not for Stage 1.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_AU
